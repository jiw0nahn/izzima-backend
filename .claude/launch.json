{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "izzima-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "web"],
      "port": 8081
    },
    {
      "name": "izzima-backend",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-lc",
        "cd backend && .venv/bin/uvicorn main:app --reload --port 8000"
      ],
      "port": 8000
    }
  ]
}
