# Supabase (base project URL only, no path suffix e.g. /rest/v1)
SUPABASE_URL=
# service_role key — anon key is blocked by RLS on insert/upload (42501)
SUPABASE_KEY=

# AI server (ai/ team's FastAPI wrapper around OCR/BLIP/Qwen/KURE, exposed via
# Cloudflare Tunnel from the GPU server) — POST {AI_SERVER_URL}/analyze.
# This is a trycloudflare.com quick-tunnel URL and changes whenever cloudflared
# restarts, so ask the AI team for the current one. If unset, run_ai_pipeline()
# fails open (returns null AI fields) rather than erroring.
AI_SERVER_URL=
